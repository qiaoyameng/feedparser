<?xml version="1.0" encoding="utf-8"?>
<!--
Every item is defined after the channel that references it.  Sequence
mode must resolve the forward references instead of reporting them missing.
-->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns="http://purl.org/rss/1.0/"
    xml:base="http://example.org/feed/">

  <channel rdf:about="http://example.org/channel">
    <title>Channel</title>
    <items>
      <rdf:Seq>
        <rdf:li resource="items/third"/>
        <rdf:li resource="items/first"/>
        <rdf:li resource="items/second"/>
      </rdf:Seq>
    </items>
  </channel>

  <item rdf:about="items/first"><title>First</title></item>
  <item rdf:about="items/second"><title>Second</title></item>
  <item rdf:about="items/third"><title>Third</title></item>
</rdf:RDF>
