<?xml version="1.0" encoding="utf-8"?>
<!--
Two channels share one item, the item definitions appear in a different
document order than the sequences, and relative rdf:about/rdf:resource
URIs are resolved against different in-scope xml:base values.
-->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns="http://purl.org/rss/1.0/"
    xml:base="http://example.org/feed/">

  <channel rdf:about="http://example.org/channel-a">
    <title>Channel A</title>
    <items>
      <rdf:Seq>
        <rdf:li resource="items/gamma"/>
        <rdf:li resource="http://example.org/feed/items/alpha"/>
        <rdf:li resource="items/shared"/>
      </rdf:Seq>
    </items>
  </channel>

  <channel rdf:about="http://example.org/channel-b">
    <title>Channel B</title>
    <items>
      <rdf:Seq>
        <rdf:li resource="items/shared"/>
        <rdf:li resource="nested/beta"/>
      </rdf:Seq>
    </items>
  </channel>

  <!-- Definitions are deliberately out of sequence order. -->
  <item rdf:about="http://example.org/feed/items/alpha">
    <title>Alpha</title>
  </item>
  <item
      rdf:about="beta"
      xml:base="http://example.org/feed/nested/">
    <title>Beta</title>
  </item>
  <item rdf:about="items/gamma">
    <title>Gamma</title>
  </item>
  <item
      rdf:about="shared"
      xml:base="http://example.org/feed/items/">
    <title>Shared</title>
  </item>
  <!-- Referenced by no sequence; must stay out of every channel. -->
  <item rdf:about="items/orphan">
    <title>Orphan</title>
  </item>
</rdf:RDF>
