<!--
Description: EPSG:3857 coordinates beyond the projection extent are rejected
Expect:      entries[0]['normalized_geometry']['converted'] == False and entries[0]['normalized_geometry']['coordinates'] is None and entries[0]['normalized_geometry']['error'] == 'coordinate-out-of-range'
-->
<feed
  xmlns="http://www.w3.org/2005/Atom"
  xmlns:georss="http://www.georss.org/georss"
  xmlns:gml="http://www.opengis.net/gml"
  >
  <entry>
    <georss:where>
      <gml:Point srsName="EPSG:3857">
        <gml:pos>30000000 0</gml:pos>
      </gml:Point>
    </georss:where>
  </entry>
</feed>
